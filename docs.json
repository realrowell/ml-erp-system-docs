        "pages": [
          "guides/admin",
          "guides/technician",
          "guides/collector"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/introduction",
          "api-reference/authentication",
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/endpoints/get-user",
              "api-reference/endpoints/get-transactions-by-date-range",
              "api-reference/endpoints/get-customer-payouts-by-date-range",
              "api-reference/endpoints/get-customer-payables-by-date-range",
              "api-reference/endpoints/get-opex-by-date-range",
              "api-reference/endpoints/get-tickets-by-date-range",
              "api-reference/endpoints/export-customers-csv",
              "api-reference/endpoints/get-vendo-from-qrcode"
